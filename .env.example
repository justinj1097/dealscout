# DealScout needs ONE key. Put your real .env in this folder OR in the folder above this repo.
# Never commit your real .env.

# Required: course Portkey key (DealScout only uses the model gpt-6-luna)
PORTKEY_API_KEY=

# Optional settings (safe defaults are built in)
# DEALSCOUT_DAILY_BUDGET=5.00          # max dollars the whole app may spend per day
# SEC_USER_AGENT=YourName your@email   # SEC asks automated tools to identify themselves
